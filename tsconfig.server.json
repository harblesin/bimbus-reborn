{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "./dist-server",
    "rootDir": ".",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "resolveJsonModule": true,
    "sourceMap": true
  },
  "include": ["main.ts", "server/**/*", "bot/**/*"],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    "dist-server",
    "**/*.test.ts",
    "**/*.spec.ts",
    "src"
  ]
}
